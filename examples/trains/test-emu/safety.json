// 내장 열차방호장치 설정 (docs/safety.md). 빠진 값은 기본값을 씁니다.
{
  "systems": ["ats", "atp", "tvm430"],
  "default": "ats",
  "ats": {
    "ackSeconds": 3,        // 속도초과 경보 후 확인 제한시간 (초)
    "toleranceKmh": 1,
    "minBrake": 1,          // 확인 후 속도가 내려갈 때까지 유지할 제동 노치
    // 코드: 이름, 조사 속도 (없으면 무제한), stop = 통과 시 비상제동
    "codes": [
      { "name": "R0", "kmh": 0, "stop": true },
      { "name": "YY", "kmh": 25 },
      { "name": "Y", "kmh": 45 },
      { "name": "YG", "kmh": 65 },
      { "name": "G" }
    ],
    // 노선 현시 번호 → 코드
    "aspects": { "0": "R0", "1": "YY", "2": "Y", "3": "YG", "4": "G" },
    "clear": "G"
  },
  "atp": {
    "brakeDelay": 1.5,      // 제동이 듣기까지 (초)
    "indicationTime": 4,    // 상용제동 곡선보다 먼저 경고하는 시간 (초)
    "releaseSpeedKmh": 15,  // 이동권한 끝 근처에서 허용하는 속도
    "staffResponsibleKmh": 40
    // serviceDecel / emergencyDecel 을 비우면 train.dat 감속도의 80% / 110%
  },
  "tvm430": {
    // 시험 전동차(110 km/h)에 맞춘 단계. KTX 기본값은 300, 270, 230, 170, 80, 0
    "steps": [110, 90, 70, 45, 25, 0],
    "warningMarginKmh": 5,
    "emergencyMarginKmh": 15
  }
}
