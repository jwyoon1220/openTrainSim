#version 460
#include "bindless.glsl"
#include "aa_common.glsl"
// Temporal anti-aliasing at render resolution (TAA mode, and in front of FSR 1).
//  * history reprojected with the camera motion vectors (closest-depth dilation),
//    Catmull-Rom filtered;
//  * clipped to the variance box of the current 3×3 neighbourhood in YCoCg;
//  * blended in a compressed (tonemapped) space; reset / off-screen → current frame.
// Inputs: TEX_SCENE (HDR), TEX_DEPTH (reverse-Z), TEX_MOTION (previous − current, UV).
layout(push_constant, scalar) uniform Push {
    uint writeSlot; // history slot written this frame (0/1)
    uint reset;     // 1 → drop the history
} pc;
layout(local_size_x = 8, local_size_y = 8) in;

vec3 toYCoCg(vec3 c) { return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b); }
vec3 fromYCoCg(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

// 5-tap Catmull-Rom (bilinear-optimised, corners dropped).
vec3 sampleHistory(uint tex, vec2 uv, vec2 size) {
    vec2 pos = uv * size, c = floor(pos - 0.5) + 0.5, f = pos - c;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f)), w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f)), w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2, o12 = w2 / w12;
    vec2 t0 = (c - 1.0) / size, t3 = (c + 2.0) / size, t12 = (c + o12) / size;
    vec3 r = texture(gTextures[tex], vec2(t12.x, t0.y)).rgb * (w12.x * w0.y) +
             texture(gTextures[tex], vec2(t0.x, t12.y)).rgb * (w0.x * w12.y) +
             texture(gTextures[tex], t12).rgb * (w12.x * w12.y) +
             texture(gTextures[tex], vec2(t3.x, t12.y)).rgb * (w3.x * w12.y) +
             texture(gTextures[tex], vec2(t12.x, t3.y)).rgb * (w12.x * w3.y);
    float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(r / wsum, vec3(0.0));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(gTextures[TEX_SCENE], 0);
    vec2 sizeF = vec2(size);
    if (any(greaterThanEqual(p, size))) return;
    uint writeSlot = pc.writeSlot, readSlot = 1u - pc.writeSlot;

    vec3 m1 = vec3(0.0), m2 = vec3(0.0), cur = vec3(0.0);
    float nearest = -1.0;
    ivec2 nearestP = p;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(p + ivec2(x, y), ivec2(0), size - 1);
            vec3 c = toYCoCg(aaCompress(texelFetch(gTextures[TEX_SCENE], q, 0).rgb));
            m1 += c;
            m2 += c * c;
            if (x == 0 && y == 0) cur = c;
            float d = texelFetch(gTextures[TEX_DEPTH], q, 0).r; // reverse-Z: larger = nearer
            if (d > nearest) nearest = d, nearestP = q;
        }
    vec3 mean = m1 / 9.0, sigma = sqrt(max(m2 / 9.0 - mean * mean, 0.0));
    vec3 lo = mean - 1.25 * sigma, hi = mean + 1.25 * sigma;

    vec2 uv = (vec2(p) + 0.5) / sizeF;
    vec2 prevUv = uv + texelFetch(gTextures[TEX_MOTION], nearestP, 0).xy;
    bool valid = pc.reset == 0u && all(greaterThanEqual(prevUv, vec2(0.0))) && all(lessThanEqual(prevUv, vec2(1.0)));
    vec3 result = cur;
    if (valid) {
        vec3 hist = toYCoCg(aaCompress(sampleHistory(TEX_HISTORY0 + readSlot, prevUv, sizeF)));
        // Clip towards the neighbourhood mean (keeps hue, removes ghosts).
        vec3 d = hist - mean, e = max(hi - mean, vec3(1e-5)), r = abs(d) / e;
        float k = max(r.x, max(r.y, r.z));
        if (k > 1.0) hist = mean + d / k;
        // Less history while the image moves fast (motion in pixels).
        float speed = length((prevUv - uv) * sizeF);
        float alpha = mix(0.08, 0.2, clamp(speed / 8.0, 0.0, 1.0));
        result = mix(hist, cur, alpha);
    }
    imageStore(gStorage[STOR_HISTORY0 + writeSlot], p, vec4(aaExpand(max(fromYCoCg(result), vec3(0.0))), 1.0));
}
