#version 460
#include "bindless.glsl"
// Screen-space ambient occlusion (phx/render/Ssao.hpp).
//  mode 0: obscurance from reverse-Z depth (spiral samples, cosine-weighted, distance falloff) → STOR_AO.r
//  mode 1: 4×4 depth-aware blur of TEX_AO, multiplied into STOR_AO_TARGET
layout(push_constant, scalar) uniform Push {
    float nearPlane, invX, invY, radius;
    float intensity, maxDistance, projX;
    uint frame, mode;
} pc;
layout(local_size_x = 8, local_size_y = 8) in;

const int kSamples = 12;

float viewZ(float d) { return d > 0.0 ? pc.nearPlane / d : 1e9; }
vec3 viewPos(vec2 uv, float z) {
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3(ndc.x * z * pc.invX, ndc.y * z * pc.invY, z);
}
float ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(gTextures[TEX_DEPTH], 0);
    if (any(greaterThanEqual(p, size))) return;
    float d = texelFetch(gTextures[TEX_DEPTH], p, 0).r;
    float z = viewZ(d);

    if (pc.mode == 1u) {
        vec4 c = imageLoad(gStorage[STOR_AO_TARGET], p);
        if (d <= 0.0) return; // sky / background
        float sum = 0.0, wsum = 0.0;
        for (int j = -2; j < 2; ++j)
            for (int i = -2; i < 2; ++i) {
                ivec2 q = clamp(p + ivec2(i, j), ivec2(0), size - 1);
                float zq = viewZ(texelFetch(gTextures[TEX_DEPTH], q, 0).r);
                float w = max(0.0, 1.0 - abs(zq - z) / (0.05 * z + 0.05));
                sum += texelFetch(gTextures[TEX_AO], q, 0).r * w;
                wsum += w;
            }
        float ao = wsum > 0.0 ? sum / wsum : 1.0;
        ao = mix(ao, 1.0, smoothstep(0.6 * pc.maxDistance, pc.maxDistance, z));
        imageStore(gStorage[STOR_AO_TARGET], p, vec4(c.rgb * ao, c.a));
        return;
    }

    if (d <= 0.0 || z > pc.maxDistance) {
        imageStore(gStorage[STOR_AO], p, vec4(1.0));
        return;
    }
    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(p) + 0.5) * texel;
    vec3 P = viewPos(uv, z);
    // normal from the smaller depth difference on each axis (no smearing across edges)
    vec3 px1 = viewPos(uv + vec2(texel.x, 0), viewZ(texelFetch(gTextures[TEX_DEPTH], min(p + ivec2(1, 0), size - 1), 0).r)) - P;
    vec3 px0 = P - viewPos(uv - vec2(texel.x, 0), viewZ(texelFetch(gTextures[TEX_DEPTH], max(p - ivec2(1, 0), ivec2(0)), 0).r));
    vec3 py1 = viewPos(uv + vec2(0, texel.y), viewZ(texelFetch(gTextures[TEX_DEPTH], min(p + ivec2(0, 1), size - 1), 0).r)) - P;
    vec3 py0 = P - viewPos(uv - vec2(0, texel.y), viewZ(texelFetch(gTextures[TEX_DEPTH], max(p - ivec2(0, 1), ivec2(0)), 0).r));
    vec3 dx = abs(px1.z) < abs(px0.z) ? px1 : px0;
    vec3 dy = abs(py1.z) < abs(py0.z) ? py1 : py0;
    vec3 n = normalize(cross(dy, dx));
    if (dot(n, P) > 0.0) n = -n; // towards the camera

    // screen radius of `radius` metres at this depth (UV units), capped for near surfaces
    float r = min(pc.radius * pc.projX * 0.5 / z, 0.15);
    float rot = 6.2831853 * ign(vec2(p) + 5.588238 * float(pc.frame & 63u));
    float sum = 0.0;
    float r2 = pc.radius * pc.radius;
    for (int i = 0; i < kSamples; ++i) {
        float a = (float(i) + 0.5) / float(kSamples);
        float ang = rot + a * 6.2831853 * 3.0; // 3 turns of a spiral
        vec2 o = vec2(cos(ang), sin(ang)) * r * sqrt(a);
        vec2 suv = uv + o;
        if (any(lessThan(suv, vec2(0.0))) || any(greaterThan(suv, vec2(1.0)))) continue;
        float sd = texelFetch(gTextures[TEX_DEPTH], ivec2(suv * vec2(size)), 0).r;
        vec3 v = viewPos(suv, viewZ(sd)) - P;
        float vv = dot(v, v);
        if (vv > r2 || vv < 1e-8) continue; // outside the radius: no influence (no haloes)
        // bounded, scale-free: cosine above the surface × distance falloff
        float cosv = dot(v, n) * inversesqrt(vv);
        sum += max(0.0, cosv - 0.15) * (1.0 - vv / r2);
    }
    float ao = clamp(1.0 - pc.intensity * 1.2 * sum / float(kSamples), 0.0, 1.0);
    imageStore(gStorage[STOR_AO], p, vec4(ao));
}
