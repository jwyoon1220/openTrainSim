#version 460
#include "bindless.glsl"
// SSAA resolve: the scene rendered at 1.5× per axis, filtered down to output resolution
// with four bilinear taps (≈ tent over the 1.5×1.5 source footprint).
layout(local_size_x = 8, local_size_y = 8) in;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(gStorage[STOR_AA_OUT]);
    if (any(greaterThanEqual(p, size))) return;
    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(p) + 0.5) * texel, o = 0.25 * texel;
    vec3 c = texture(gTextures[TEX_SCENE], uv + vec2(-o.x, -o.y)).rgb + texture(gTextures[TEX_SCENE], uv + vec2(o.x, -o.y)).rgb +
             texture(gTextures[TEX_SCENE], uv + vec2(-o.x, o.y)).rgb + texture(gTextures[TEX_SCENE], uv + vec2(o.x, o.y)).rgb;
    imageStore(gStorage[STOR_AA_OUT], p, vec4(c * 0.25, 1.0));
}
